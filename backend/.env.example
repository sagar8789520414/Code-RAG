# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (your Netlify URL in production), or *
CORS_ORIGINS=http://localhost:5173
# When set, indexing/sync/delete/benchmark endpoints require header `x-api-key: <value>` (min 16 chars)
ADMIN_API_KEY=

# ---------------------------------------------------------------- databases (required)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=code_rag
# Must support RediSearch (FT.* + vectors): Redis 8+, Redis Stack, or Redis Cloud.
# Upstash and plain Redis OSS 7 do NOT work.
REDIS_URL=redis://127.0.0.1:6379
REDIS_INDEX_NAME=idx:code_chunks
REDIS_KEY_PREFIX=cr:chunk:

# ---------------------------------------------------------------- LLMs (required)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Comma-separated fallback chains; each model is tried in order when the previous is overloaded.
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_FAST_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# ---------------------------------------------------------------- embeddings
EMBEDDING_MODEL=gemini-embedding-001
# Changing the dimension requires dropping the Redis index (or a new REDIS_INDEX_NAME) and reindexing.
EMBEDDING_DIM=768
# Client-side pacing; defaults fit the Gemini free tier. Raise on a paid key (e.g. 1000000 / 3000).
EMBEDDING_TPM=25000
EMBEDDING_RPM=90

# ---------------------------------------------------------------- ingestion
DATA_DIR=.data
# Allow absolute local paths as repo "URLs" (development only)
ALLOW_LOCAL_REPOS=false
MAX_FILE_BYTES=300000
MAX_FILES_PER_REPO=5000
MAX_CHUNK_CHARS=3500
# Private GitHub repos (sent as a per-command auth header, never written to .git/config)
GITHUB_TOKEN=
# Enables POST /api/webhooks/github (push events trigger incremental sync)
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- retrieval / agent
RRF_K=60
SEARCH_CANDIDATES=50
RERANK_TOP_N=20
# Rerank is skipped (RRF order kept) when the judge takes longer than this
RERANK_TIMEOUT_MS=10000
AGENT_MAX_HOPS=2
AGENT_CONTEXT_CHUNKS=14
QUERY_RATE_LIMIT_PER_MIN=30
